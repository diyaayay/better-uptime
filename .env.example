# Copy this file to `.env` in the repository root and fill in values.
# `.env` is gitignored — never commit real secrets.

# --- PostgreSQL (matches docker-compose defaults) ---
POSTGRES_USER=betteruptime
POSTGRES_PASSWORD=betteruptime
POSTGRES_DB=betteruptime

# Local `cargo run -p api`: use 127.0.0.1. With `docker compose up`, the API
# container overrides DATABASE_URL to use hostname `postgres`.
DATABASE_URL=postgresql://betteruptime:betteruptime@127.0.0.1:5432/betteruptime

# --- JWT (required; at least 32 characters) ---
# Generate: openssl rand -base64 32
JWT_SECRET=replace-this-with-openssl-rand-base64-32-chars-min

# Optional overrides
# POSTGRES_PORT=5432
# API_PORT=3000
